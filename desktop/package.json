{
  "name": "karaoke-hub-desktop",
  "version": "0.1.3",
  "private": true,
  "description": "KARAOKE.HUB Windows Player with local key and tempo controls",
  "author": "KARAOKE.HUB",
  "main": "main.cjs",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.cjs",
    "start": "npm run prepare:assets && electron .",
    "pretest": "npm run prepare:assets",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:electron": "node tests/electron-smoke.cjs",
    "test:hosted": "node tests/hosted-smoke.cjs",
    "pretest:electron": "npm run prepare:assets",
    "pack": "npm run prepare:assets && electron-builder --win --x64 --dir",
    "dist": "npm run prepare:assets && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "app.karaokehub.player",
    "productName": "KARAOKE.HUB",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "*preload.cjs",
      "lib/**/*",
      "ui/**/*",
      "audio/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "KaraokeHub-Setup-${version}-${arch}.${ext}"
    }
  }
}
