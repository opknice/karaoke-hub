# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never prefix this secret with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-key

# YouTube Data API v3 (Optional for live search, seeds are built-in)
YOUTUBE_API_KEY=your-youtube-api-key
# Persistent search cache/budget is stored in Supabase for Vercel compatibility.
YOUTUBE_SEARCH_DAILY_LIMIT=100
# Vercel sends this as a Bearer token to the protected daily Cron route.
CRON_SECRET=replace-with-at-least-16-random-characters
# Long-running self-hosted Node only. Vercel ignores this timer and uses Cron.
KARAOKE_CATALOG_AUTO_SYNC=0

# App URL for QR codes and invitations
NEXT_PUBLIC_APP_URL=http://localhost:3000
