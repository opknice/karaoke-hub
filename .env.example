# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never prefix this secret with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-key

# YouTube Data API v3 (Optional for live search, seeds are built-in)
YOUTUBE_API_KEY=your-youtube-api-key
# Persistent cache/budget: writable local disk shared by all workers on this host.
YOUTUBE_SEARCH_DB_PATH=.data/youtube-search.sqlite
YOUTUBE_SEARCH_DAILY_LIMIT=100
# Long-running Node server: daily maintenance, full channel refresh every 7 days.
# Set 0 when using an external scheduler/serverless host.
KARAOKE_CATALOG_AUTO_SYNC=1

# App URL for QR codes and invitations
NEXT_PUBLIC_APP_URL=http://localhost:3000
